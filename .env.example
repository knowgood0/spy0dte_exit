WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION=us
DRY_RUN=true
HISTORY_COUNT=300
POLL_SECONDS=15
IDLE_POLL_SECONDS=30
OPTION_QUANTITY=1
STATE_PATH=bot_state.json

# Pine-derived strategy
STOP_ATR_MULT=1.5
TARGET_ATR_MULT=2.0
BREAKEVEN_ATR_MULT=1.0
USE_BREAKEVEN=true
USE_ZONE_EXIT=true
MAX_BARS_IN_TRADE=12

# Option risk controls (new; all configurable)
USE_OPTION_PREMIUM_RISK=true
OPTION_STOP_LOSS_PCT=0.35
OPTION_TAKE_PROFIT_PCT=0.50
OPTION_BREAKEVEN_TRIGGER_PCT=0.25
OPTION_BREAKEVEN_FLOOR_PCT=0.00
MAX_HOLD_MINUTES=60

# Session safety, New York time
TRADING_TIMEZONE=America/New_York
RTH_START=09:30
RTH_END=16:00
NO_NEW_ENTRIES_AFTER=15:45
FORCE_EXIT_TIME=15:55

# Pending-order/retry safety
ENTRY_ORDER_TIMEOUT_SECONDS=30
EXIT_ORDER_TIMEOUT_SECONDS=20
MAX_EXIT_RETRIES=5
RECOVERY_POLL_SECONDS=10
WEBULL_MIN_REQUEST_INTERVAL=1.05
